<Window x:Class="Projeto_POO.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_POO"
        mc:Ignorable="d"
        Title="Bem-vindo ao GameHub" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#141414"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Estilo do Botão Arredondado -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="40,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid>
            <!-- Fundo Decorativo -->
            <Ellipse Width="300" Height="300" Fill="#2563EB" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,-100,0"/>
            <Ellipse Width="400" Height="400" Fill="#16A34A" Opacity="0.1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-150"/>

            <!-- Conteúdo Principal -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Classic Games" 
                           Foreground="White" 
                           FontSize="48" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                
                <TextBlock Text="O seu acervo definitivo de jogos antigos" 
                           Foreground="#A0A0A0" 
                           FontSize="18" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,50"/>

                <Button Content="Entrar" 
                        Style="{StaticResource RoundedButtonStyle}" 
                        Click="Entrar_Click" 
                        HorizontalAlignment="Center"
                        Width="200" Height="50"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
