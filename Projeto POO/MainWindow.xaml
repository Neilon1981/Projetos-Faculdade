<Window x:Class="Projeto_POO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_POO"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        mc:Ignorable="d"
        Title="GameHub"
        Height="780"
        Width="1200"
        Background="#141414"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPO -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Classic Games"
               FontSize="34"
               FontWeight="Bold"
               Foreground="White"/>

                <TextBlock Text="Um acervo de jogos antigos"
               Margin="0,4,0,0"
               FontSize="14"
               Foreground="#909090"/>

                <!-- FILTROS -->
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <!-- TODOS -->
                    <Button x:Name="AllGamesButton" Content="Todos os Jogos" Click="AllGames_Click" Height="38" Padding="18,0" Margin="0,0,10,0" Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <!-- FAVORITOS -->
                    <Button x:Name="FavoritesButton" Click="Favorites_Click" Height="38" Padding="18,0" Margin="0,0,10,0" Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Heart" Width="14" Height="14" Foreground="#EF4444" Margin="0,0,8,0"/>
                            <TextBlock Text="Favoritos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- CLASSIFICAR POR AVALIAÇÃO -->
                    <Button x:Name="SortRatingButton" Click="SortRating_Click" Height="38" Padding="18,0" Margin="0,0,10,0" Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="SortAmountDesc" Width="14" Height="14" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Classificar por Avaliação" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- MAIS JOGADOS -->
                    <Button x:Name="SortMostPlayedButton" Click="SortMostPlayed_Click" Height="38" Padding="18,0" Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Trophy" Width="14" Height="14" Foreground="#FBBF24" Margin="0,0,8,0"/>
                            <TextBlock Text="Mais Jogados" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <!-- PESQUISA -->
            <Border Grid.Column="2" Height="42" CornerRadius="10" Background="#1F1F1F">
                <Grid>
                    <!-- TEXTBOX -->
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" VerticalContentAlignment="Center" Padding="15,0" CaretBrush="White" TextChanged="SearchBox_TextChanged"/>
                    <!-- PLACEHOLDER -->
                    <TextBlock Text="Pesquisar jogo..." Margin="15,0,0,0" Foreground="#707070" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

        </Grid>

        <!-- LISTA DINÂMICA -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GameList" ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- CARD -->
                        <Border Width="360" Margin="10" CornerRadius="18" Background="#1E1E1E">

                            <StackPanel>

                                <!-- CAPA -->
                                <Grid Height="241">
                                    <Border CornerRadius="18,18,0,0" ClipToBounds="True">
                                        <Image Source="{Binding CoverPath}" Stretch="Fill"/>
                                    </Border>
                                    <!-- ESTRELAS E FAVORITO -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Panel.ZIndex="10">
                                        <!-- ESTRELAS -->
                                        <Border Background="#88000000" CornerRadius="21" Margin="0,0,8,0" Padding="15,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Click="Star_Click" Tag="1" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <fa:ImageAwesome Width="18" Height="18" Margin="2">
                                                        <fa:ImageAwesome.Style>
                                                            <Style TargetType="fa:ImageAwesome">
                                                                <Setter Property="Icon" Value="StarOutline"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="1">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="2">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="3">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="4">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="5">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa:ImageAwesome.Style>
                                                    </fa:ImageAwesome>
                                                </Button>
                                                <Button Click="Star_Click" Tag="2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <fa:ImageAwesome Width="18" Height="18" Margin="2">
                                                        <fa:ImageAwesome.Style>
                                                            <Style TargetType="fa:ImageAwesome">
                                                                <Setter Property="Icon" Value="StarOutline"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="2">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="3">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="4">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="5">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa:ImageAwesome.Style>
                                                    </fa:ImageAwesome>
                                                </Button>
                                                <Button Click="Star_Click" Tag="3" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <fa:ImageAwesome Width="18" Height="18" Margin="2">
                                                        <fa:ImageAwesome.Style>
                                                            <Style TargetType="fa:ImageAwesome">
                                                                <Setter Property="Icon" Value="StarOutline"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="3">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="4">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="5">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa:ImageAwesome.Style>
                                                    </fa:ImageAwesome>
                                                </Button>
                                                <Button Click="Star_Click" Tag="4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <fa:ImageAwesome Width="18" Height="18" Margin="2">
                                                        <fa:ImageAwesome.Style>
                                                            <Style TargetType="fa:ImageAwesome">
                                                                <Setter Property="Icon" Value="StarOutline"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="4">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="5">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa:ImageAwesome.Style>
                                                    </fa:ImageAwesome>
                                                </Button>
                                                <Button Click="Star_Click" Tag="5" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <fa:ImageAwesome Width="18" Height="18" Margin="2">
                                                        <fa:ImageAwesome.Style>
                                                            <Style TargetType="fa:ImageAwesome">
                                                                <Setter Property="Icon" Value="StarOutline"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="5">
                                                                        <Setter Property="Icon" Value="Star"/>
                                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa:ImageAwesome.Style>
                                                    </fa:ImageAwesome>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <!-- BOTÃO FAVORITO -->
                                        <Button Width="42" Height="42" Background="#66000000" BorderThickness="0" Click="Favorite_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="21">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <fa:ImageAwesome Width="20"
                             Height="20">

                                                <fa:ImageAwesome.Style>
                                                    <Style TargetType="fa:ImageAwesome">

                                                        <Setter Property="Icon" Value="HeartOutline"/>
                                                        <Setter Property="Foreground" Value="White"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                                <Setter Property="Icon" Value="Heart"/>
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>

                                                    </Style>
                                                </fa:ImageAwesome.Style>

                                            </fa:ImageAwesome>

                                        </Button>
                                    </StackPanel>
                                </Grid>


                                <!-- INFO -->
                                <Grid Margin="14">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="90"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="150"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Text="{Binding Name}" Grid.Row="0" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Grid.Row="1" Margin="0,4,0,0" FontSize="13" Foreground="#A0A0A0"/>
                                    <TextBlock Text="{Binding Description}" Grid.Row="2" FontSize="12" Foreground="#808080" TextWrapping="Wrap" MaxHeight="90" TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="300">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Width="280"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Size}" Foreground="#4ADE80" FontWeight="Bold" Margin="0,0,15,0"/>
                                        <TextBlock Text="{Binding PlayCount, StringFormat=Jogadas: {0}}" Foreground="#60A5FA" FontWeight="Bold"/>
                                    </StackPanel>
                                    <!-- BOTÕES -->
                                    <StackPanel Grid.Row="5" Margin="0,16,0,0">

                                        <!-- BOTÃO INSTALAR -->
                                        <Button Content="Instalar" Click="InstallGame_Click" Height="42" FontWeight="SemiBold" Background="#16A34A" Foreground="White" BorderThickness="0">

                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>

                                        </Button>

                                        <!-- ÁREA INSTALADO -->
                                        <StackPanel>

                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Button Content="Jogar" Click="PlayGame_Click" Height="42" Margin="0,0,0,8" FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="Reparar" Height="38" FontWeight="SemiBold" Background="#2A2A2A" Foreground="White" BorderBrush="#3A3A3A"/>
                                                <Button Grid.Column="2" Content="Desinstalar" Click="UninstallGame_Click" Height="38" FontWeight="SemiBold" Background="#3A1D1D" Foreground="#FF6B6B" BorderBrush="#5A2A2A"/>
                                            </Grid>

                                        </StackPanel>

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>
</Window>
