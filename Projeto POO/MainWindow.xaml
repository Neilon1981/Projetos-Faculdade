<Window x:Class="Projeto_POO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_POO"
        mc:Ignorable="d"
        Title="GameHub"
        Height="720"
        Width="1200"
        Background="#141414"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPO -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Classic Games" FontSize="34" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Um acervo de jogos antigos" Margin="0,4,0,0" FontSize="14" Foreground="#909090"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <ComboBox Name="Videogames" SelectionChanged="Videogames_SelectionChanged" VerticalContentAlignment="Center" FontSize="17" FontFamily="Segoe UI Semibold" Margin="13"/>
            </Grid>
            
            <!-- PESQUISA -->
            <Border Grid.Column="2" Height="42" CornerRadius="10" Background="#1F1F1F">
                <Grid>
                    <!-- TEXTBOX -->
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" VerticalContentAlignment="Center" Padding="15,0" CaretBrush="White" TextChanged="SearchBox_TextChanged"/>
                    <!-- PLACEHOLDER -->
                    <TextBlock Text="Pesquisar jogo..." Margin="15,0,0,0" Foreground="#707070" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

        </Grid>

        <!-- LISTA DINÂMICA -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Games}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- CARD -->
                        <!-- CARD -->
                        <Border Width="360" Margin="10" CornerRadius="18" Background="#1E1E1E">

                            <StackPanel>

                                <!-- CAPA -->
                                <Border Height="241" CornerRadius="18,18,0,0" ClipToBounds="True">

                                    <Image Source="{Binding CoverPath}" Stretch="Fill"/>
                                </Border>

                                <!-- INFO -->
                                <StackPanel Margin="14">

                                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Category}" Margin="0,4,0,0" FontSize="13" Foreground="#A0A0A0"/>

                                    <TextBlock Text="{Binding Description}" Margin="0,10,0,0" FontSize="12" Foreground="#808080" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="300">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Width="280"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>

                                    <TextBlock Margin="0,10,0,0" Foreground="#4ADE80" FontWeight="Bold">
                                        <Run Text="{Binding Size}"/>
                                        <Run Text=" GB"/>
                                    </TextBlock>

                                    <!-- BOTÕES -->
                                    <StackPanel Margin="0,16,0,0">

                                        <!-- BOTÃO INSTALAR -->
                                        <Button Content="Instalar" Click="InstallGame_Click" Height="42" FontWeight="SemiBold" Background="#16A34A" Foreground="White" BorderThickness="0">

                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>

                                        </Button>

                                        <!-- ÁREA INSTALADO -->
                                        <StackPanel>

                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <Button Content="Jogar" Click="PlayGame_Click" Height="42" Margin="0,0,0,8" FontWeight="SemiBold" Background="#2563EB" Foreground="White" BorderThickness="0"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="Reparar" Height="38" FontWeight="SemiBold" Background="#2A2A2A" Foreground="White" BorderBrush="#3A3A3A"/>
                                                <Button Grid.Column="2" Content="Desinstalar" Click="UninstallGame_Click" Height="38" FontWeight="SemiBold" Background="#3A1D1D" Foreground="#FF6B6B" BorderBrush="#5A2A2A"/>
                                            </Grid>

                                        </StackPanel>

                                    </StackPanel>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>
</Window>
