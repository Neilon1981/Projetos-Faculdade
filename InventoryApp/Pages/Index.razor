@page "/"

<div class="text-center mb-4">
    <h2 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Bem vindo ao controle de personagens lego</h2>
    <p>Manage your items with ease and elegance.</p>
</div>

<div class="action-grid">
    <div class="card text-center">
        <h3>Categories</h3>
        <p>View and manage all your existing items.</p>
        <a href="categories" class="btn btn-primary btn-large" style="margin-top: 1rem; width: 100%;">Ingressar em Categorias</a>
    </div>

    <div class="card text-center">
        <h3>New Item</h3>
        <p>Add a new item to your inventory database.</p>
        <a href="add-item" class="btn btn-secondary btn-large" style="margin-top: 1rem; width: 100%;">Cadastrar Novo Item</a>
    </div>
</div>
